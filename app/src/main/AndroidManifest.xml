<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- Declare camera as an optional feature -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:requestLegacyExternalStorage="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RentWise"
        tools:targetApi="31">

        <activity
            android:name=".activity.login_register.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RentWise">
            <!-- Intent filter for main activity -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.other.CalculatorBillActivity"
            android:exported="true"
            android:theme="@style/Base.Theme.RentWise" />

<!--        <activity-->
<!--            android:name=".activity.landloard_setup.SetupRoomTypeAndPricingActivity"-->
<!--            android:exported="true"-->
<!--            android:theme="@style/Base.Theme.RentWise" />-->

        <activity
            android:name=".activity.other.ContactActivity"
            android:exported="true"
            android:theme="@style/Base.Theme.RentWise" />

        <activity
            android:name=".activity.ProfileActivity"
            android:exported="true"
            android:theme="@style/Base.Theme.RentWise" />

        <activity
            android:name=".activity.landloard_setup.SetupRoomTypeAndPricingActivity"
            android:exported="true"
            android:theme="@style/Base.Theme.RentWise" />

        <activity
            android:name=".activity.landloard_setup.ShowRoomSetupOptionsActivity"
            android:exported="true"
            android:theme="@style/Base.Theme.RentWise" />

        <activity
            android:name=".activity.landloard_setup.AssignRoomActivity"
            android:exported="true"
            android:theme="@style/Base.Theme.RentWise" />

        <activity
            android:name=".activity.login_register.LandlordActivity"
            android:exported="true"
            android:theme="@style/Base.Theme.RentWise">

        </activity>

        <activity
            android:name=".activity.InvoiceActivity"
            android:exported="true"
            android:theme="@style/Base.Theme.RentWise" />
    </application>

</manifest>