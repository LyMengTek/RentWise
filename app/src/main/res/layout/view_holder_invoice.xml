<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_both"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    app:cardCornerRadius="100dp"
                    app:cardElevation="4dp"
                    app:cardPreventCornerOverlap="true">

                    <ImageView
                        android:id="@+id/inProfile"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_circle"
                        android:src="@mipmap/ic_person" />
                </androidx.cardview.widget.CardView>


            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/inUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_semibold"
                    android:letterSpacing="0.08"
                    android:text="UserName"
                    android:textColor="@color/font"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/inFloor"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/manrope_bold"
                        android:gravity="center"
                        android:text="Floor: 1"
                        android:textColor="@color/font"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/inRoom"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/manrope_bold"
                        android:gravity="center"
                        android:text="Room: 1"
                        android:textColor="@color/font"
                        android:textSize="16sp" />
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/inDate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/manrope_semibold"
                    android:gravity="end"
                    android:text="Sep 30, 1832"
                    android:textColor="@color/font"
                    android:textSize="16sp" />

            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/dashed_line"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_semibold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_semibold"
                        android:letterSpacing="0.08"
                        android:text="Electricity: "
                        android:textColor="@color/font"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_semibold"
                        android:letterSpacing="0.08"
                        android:text="Water: "
                        android:textColor="@color/font"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_semibold"
                        android:letterSpacing="0.08"
                        android:text="Other: "
                        android:textColor="@color/font"
                        android:textSize="16sp" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_semibold"
                        android:letterSpacing="0.08"
                        android:text="Use"
                        android:textColor="@color/font"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/inUseElectricity"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_semibold"
                        android:letterSpacing="0.08"
                        android:text="10.0"
                        android:textColor="@color/font"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/inUseWater"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_semibold"
                        android:letterSpacing="0.08"
                        android:text="10.0"
                        android:textColor="@color/font"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/inUseOther"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_semibold"
                        android:letterSpacing="0.08"
                        android:text="10.0"
                        android:textColor="@color/font"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_semibold"
                        android:letterSpacing="0.08"
                        android:text="Cost"
                        android:textColor="@color/font"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/inCostElectricity"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_semibold"
                        android:letterSpacing="0.08"
                        android:text="10.0"
                        android:textColor="@color/font"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/inCostWater"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_semibold"
                        android:letterSpacing="0.08"
                        android:text="10.0"
                        android:textColor="@color/font"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/inCostOther"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_semibold"
                        android:letterSpacing="0.08"
                        android:text="10.0"
                        android:textColor="@color/font"
                        android:textSize="16sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/manrope_semibold"
                android:letterSpacing="0.08"
                android:text="Total: "
                android:textColor="@color/font"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/inTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/manrope_semibold"
                android:letterSpacing="0.08"
                android:text="100"
                android:textColor="@color/font"
                android:textSize="16sp"
                android:gravity="end"/>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>